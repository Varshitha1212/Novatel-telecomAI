QDRANT_API_KEY=
QDRANT_COLLECTION=telecom_support
# Optional provider integration base URL must expose POST /balance and POST /network.
TELECOM_API_URL=
TELECOM_API_KEY=
# Optional support escalation webhook must accept { "issue_summary": "..." } and return { "ticket_id": "..." }.
TELECOM_ESCALATION_URL=
SUPPORT_CONTACT=
